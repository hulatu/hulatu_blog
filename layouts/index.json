{{- /* ============================================================
       站内搜索索引（2026-10-26 新增；2026-11-22 改成「重点信息索引」）

       ── 为什么要有这个文件 ──────────────────────────────────────────
       站内搜索最早的列表页实现只是 `title.includes(term)` —— **只搜标题**。
       140 篇文章里，很多标题是比喻式的（「角落里的学生」「过早引用」），
       想找「降噪耳机」这种正文里的词，一个字都搜不出来。

       ── 字段 ────────────────────────────────────────────────────────
         t  标题（文章 h1）
         u  站内路径（相对，`/posts/2026/.../`）
         g  标签数组（用来在结果里显示来源）
         h  h2 / h3 章节标题数组
         k  重点关键词：description + 粗体 + 「」短语
         d  引用框内容（多个引用合并后截 300 字）

       ⚠️ **2026-11-22 起不再索引正文全文**：归档页搜索框删掉后，唯一消费者
          是命令面板；面板只用摘要做最后一级匹配，不展示全文。旧版 `d` 是
          正文前 1000 字，索引 502 KB / gzip 213 KB；改成重点信息后实测
          **137 KB / gzip 61 KB**，首次打开面板明显更轻。
       ⚠️ 标题 / 章节 / 关键词都是作者主动强调过的内容，比正文里顺嘴提到的
          词更能代表「这篇在讲什么」；引用框通常就是全文最值得记的句子。
       ⚠️ 键名一个字母是**体积**考虑：133 条 × 6 个键，写成
          title/url/tags/headings/keywords/quote 光键名就多出好几 KB。
       ⚠️ 排序固定「按日期倒序」：搜索结果的同分项要稳定，不能每次构建换顺序。

       ── 输出方式 ────────────────────────────────────────────────────
       `hugo.toml` 的 `[outputs] home` 加了 "JSON"，本文件就是首页的
       JSON 视图，产物落在 **`/index.json`**。
       ⚠️ 文件名必须是 `index.json`（不是 `_default/list.json`）——
          home 的输出格式按 `layouts/index.<ext>` 找模板，找不到会退到
          `_default/list.<ext>`，而那份会带分页变量、结构也不对。
       ============================================================ */ -}}
{{- $items := slice -}}
{{- range where .Site.RegularPages "Type" "in" (slice "posts" "weekly") -}}
  {{- $html := printf "%s" .Content -}}

  {{- /* h2 / h3：目录里的「章节」，也是搜索的二级命中。
       ⚠️ 标题要去掉行尾的 `#` 锚点：render-heading.html 在标题末尾输出了
          `<a class="heading-anchor">#</a>`，剥完标签会剩下一个孤零零的 `#`。
       ⚠️ 别把 `<h1>` 也收进来：文章页正文里没有 h1（标题在模板里），
          真出现的话多半是作者手写的，收进来等于重复标题。 */ -}}
  {{- $heads := slice -}}
  {{- range findRE `<h[23]\b[^>]*>.*?</h[23]>` $html -}}
    {{- $h := . | replaceRE `<[^>]*>` "" | replaceRE `#\s*$` "" | strings.TrimSpace -}}
    {{- with $h }}{{ $heads = $heads | append . }}{{ end -}}
  {{- end -}}
  {{- $heads = $heads | uniq -}}

  {{- /* 关键词：description + 粗体表达 + 「」短语。
       ⚠️ 标题单独放 h，不再塞进 k —— 面板要把「章节命中」和「关键词命中」
          显示成不同的理由。
       ⚠️ `uniq` 不能省：一篇讲跑步的文章里「跑步」可能在几十处粗体里出现。 */ -}}
  {{- $kw := slice -}}
  {{- with .Description }}{{ $kw = $kw | append . }}{{ end -}}
  {{- range findRE `<strong\b[^>]*>.*?</strong>` $html -}}
    {{- $b := . | replaceRE `<[^>]*>` "" | strings.TrimSpace -}}
    {{- with $b }}{{ $kw = $kw | append . }}{{ end -}}
  {{- end -}}
  {{- range findRE `「[^」]{2,24}」` $html -}}
    {{- $q := . | replaceRE `<[^>]*>` "" | strings.TrimPrefix "「" | strings.TrimSuffix "」" | strings.TrimSpace -}}
    {{- with $q }}{{ $kw = $kw | append . }}{{ end -}}
  {{- end -}}
  {{- $kw = $kw | uniq -}}

  {{- /* 引用框：正文里被作者单独拎出来的句子，通常就是全文最值得记的几句。
       ⚠️ 多段合并后截 300 字，避免一期周刊几十条引用把索引撑大。 */ -}}
  {{- $quotes := slice -}}
  {{- range findRE `(?s)<blockquote\b[^>]*>.*?</blockquote>` $html -}}
    {{- $q := . | replaceRE `<[^>]*>` " " | replaceRE `\s+` " " | strings.TrimSpace -}}
    {{- with $q }}{{ $quotes = $quotes | append . }}{{ end -}}
  {{- end -}}
  {{- $quoteText := delimit $quotes " … " | strings.TrimSpace -}}
  {{- $quoteText = substr $quoteText 0 300 -}}

  {{- $items = $items | append (dict
      "t" .Title
      "u" .RelPermalink
      "g" (.Params.tags | default slice)
      "h" $heads
      "k" $kw
      "d" $quoteText) -}}
{{- end -}}
{{- $items | jsonify -}}
